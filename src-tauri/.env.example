# Configuración local de diagnóstico directo en Rust (solo herramienta de desarrollo)
# NOTA: En uso normal y en la versión distribuida, la aplicación de escritorio NO lee esta clave;
# se comunica con `studia-backend`, donde reside la clave privada del servidor.
#
# Para ejecutar la prueba manual de desarrollo en PowerShell:
#   $env:GEMINI_API_KEY = "tu_clave_aqui"
#   $env:GEMINI_MODEL = "gemini-3.5-flash-lite"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
